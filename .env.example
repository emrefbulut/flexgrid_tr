NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public-grid adapters. The app works without these by using deterministic demo/fallback data.

# ENTSO-E is the one adapter that is actually implemented. With a token set,
# /api/grid-signal?provider=entsoe returns measured system load and day-ahead
# price; without it the same endpoint returns modeled data. Free registration:
# https://transparency.entsoe.eu/ -> account settings -> request API access.
ENTSOE_TOKEN=

# Documented adapter targets, not implemented yet.
EPIAS_TGT=
ELECTRICITY_MAPS_TOKEN=
EMBER_API_KEY=
